# Optional. The core workflow runs fully local without any paid API.
# Set only if you want ElevenLabs text-to-speech for voiceovers.
ELEVENLABS_API_KEY=

# Optional stock footage search (free keys).
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Optional LLM providers (OpenAI-compatible); pick one with FYE_LLM_PROVIDER.
OPENAI_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Optional: which LLM provider to use (openai, kimi, deepseek, gemini, ollama).
FYE_LLM_PROVIDER=
