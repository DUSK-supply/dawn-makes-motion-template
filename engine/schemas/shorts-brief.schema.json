{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShortsBrief",
  "type": "object",
  "required": ["sourceSlug", "clips"],
  "properties": {
    "sourceSlug": { "type": "string" },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "hook"],
        "properties": {
          "id": { "type": "string" },
          "start": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?$" },
          "end": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?$" },
          "hook": { "type": "string" },
          "title": { "type": "string", "maxLength": 100 }
        }
      }
    }
  }
}
