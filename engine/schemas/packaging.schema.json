{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Packaging",
  "type": "object",
  "required": ["slug", "titles", "thumbnailConcepts", "description", "disclosure"],
  "properties": {
    "slug": { "type": "string" },
    "titles": { "type": "array", "items": { "type": "string", "maxLength": 100 }, "minItems": 1 },
    "thumbnailConcepts": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "description": { "type": "string", "maxLength": 5000 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "disclosure": {
      "type": "object",
      "required": ["alteredOrSynthetic", "sponsored"],
      "properties": {
        "alteredOrSynthetic": { "type": "boolean" },
        "sponsored": { "type": "boolean" },
        "text": { "type": "string" }
      }
    }
  }
}
